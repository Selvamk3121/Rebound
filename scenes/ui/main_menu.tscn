[node name="ObjectiveLabel" type="RichTextLabel" parent="GuidanceModal/Panel/MarginContainer/VBoxContainer/ScrollContainer/ContentVBox"]
layout_mode = 2
bbcode_enabled = true
text = "[color=#33e0cc][b]MISSION OBJECTIVE:[/b][/color]
Bio-weapons containment has failed in Sector 1. Purge all mutant specimens to secure the facility and unlock extraction."
fit_content = true

[node name="RicochetLabel" type="RichTextLabel" parent="GuidanceModal/Panel/MarginContainer/VBoxContainer/ScrollContainer/ContentVBox"]
layout_mode = 2
bbcode_enabled = true
text = "[color=#33e0cc][b]KINETIC RICOCHET SYSTEM:[/b][/color]
Mutated carapaces resist frontal ballistics. Bounce rounds off metallic bulkheads and walls using the holographic laser sight to strike weak points from around cover."
fit_content = true

[node name="ArsenalLabel" type="RichTextLabel" parent="GuidanceModal/Panel/MarginContainer/VBoxContainer/ScrollContainer/ContentVBox"]
layout_mode = 2
bbcode_enabled = true
text = "[color=#33e0cc][b]TACTICAL WEAPON LOADOUT:[/b][/color]
• [b][1] Laser Pulse Pistol:[/b] Rapid-fire precision laser bolt with high velocity.
• [b][2] Security Ricochet Shotgun:[/b] 3-pellet kinetic spread; bounces into corridors.
• [b][3] Heavy Plasma Cannon:[/b] High-yield 4-bounce cyan energy beam.
• [b][4] Heavy Kinetic Vulcan:[/b] Suppressive auto-cannon with immense fire rate.
• [b]Mouse Scroll Wheel:[/b] Seamlessly cycle through active weaponry."
fit_content = true

[node name="ControlsLabel" type="RichTextLabel" parent="GuidanceModal/Panel/MarginContainer/VBoxContainer/ScrollContainer/ContentVBox"]
layout_mode = 2
bbcode_enabled = true
text = "[color=#33e0cc][b]OPERATIVE CONTROLS:[/b][/color]
• [b]W / A / S / D:[/b] 8-Direction normalized tactical movement
• [b]Mouse Aim:[/b] 360° Pivot aim rotation
• [b]Space / Left Click:[/b] Fire equipped weapon
• [b]R Key:[/b] Reload magazine / Retry sector upon completion or defeat
• [b]H Key:[/b] Use Medical Kit (+40 HP restore)
• [b]Escape:[/b] Pause game / Close briefing"
fit_content = true

